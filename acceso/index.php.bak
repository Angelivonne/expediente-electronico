<?php
/**
 * Iniciar sesiÃ³n: correo y despuÃ©s contraseÃ±a.
 */
define('PAGINA_PUBLICA', true);
require_once __DIR__ . '/../app/nucleo/inicio.php';
require_once __DIR__ . '/../app/servicios/cuenta/acceso.php';
require_once __DIR__ . '/../app/servicios/cuenta/claves.php';

if (usuarioActual()) {
    redirigir(rutaInicio());
}
// "Usar otra cuenta" desde la pantalla del cÃ³digo
if (isset($_GET['cancelar'])) {
    unset($_SESSION['acceso_pendiente']);
}

const INTENTOS_POR_CORREO = 5;    // fallos por correo desde la misma IP cada 15 min
const FALLOS_POR_CORREO   = 30;   // fallos por correo desde cualquier IP: frena ataques repartidos sin bloquear al dueÃ±o con 5 intentos
const INTENTOS_POR_IP     = 20;   // por direcciÃ³n IP cada 15 min
const VENTANA_SEGUNDOS    = 900;
// Hash Argon2id vÃ¡lido de una cadena aleatoria: se verifica contra Ã©l cuando el correo no existe,
// para que el tiempo de respuesta no revele quÃ© correos estÃ¡n registrados.
const HASH_SIMULADO = '$argon2id$v=19$m=65536,t=4,p=1$UnpvQzVlY2F0N09aRW94SQ$3smggvMmTkQs/fPd8rnrD9DzjKtacfEfaQ+uQ6noM6E';

$correo       = '';
$notificacion = tomarFlash();
if (!empty($_SESSION['aviso_sesion'])) {
    $notificacion = ['tipo' => 'error', 'texto' => $_SESSION['aviso_sesion']];
    unset($_SESSION['aviso_sesion']);
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $correo = mb_strtolower(trim((string) ($_POST['correo'] ?? '')));
    $clave  = (string) ($_POST['clave'] ?? '');
    $error  = null;

    if (!csrfValido()) {
        $error = 'La sesiÃ³n expirÃ³. Vuelve a intentarlo.';
    } elseif (RECAPTCHA_SITE_KEY !== '' && $correo !== '' && !recaptchaVerificar((string) ($_POST['g-recaptcha-response'] ?? ''))) {
        $error = 'Verifica que no eres un robot (reCAPTCHA).';
    } elseif ($correo === '' || $clave === '' || mb_strlen($correo) > 160 || strlen($clave) > 1024) {
        $error = 'Escribe tu correo y tu contraseÃ±a.';
    } elseif (!dentroDelLimite('acceso:ip:' . ipCliente(), INTENTOS_POR_IP, VENTANA_SEGUNDOS)
           || limiteSuperado('acceso:fallo:correo-ip:' . $correo . ':' . ipCliente(), INTENTOS_POR_CORREO)
           || limiteSuperado('acceso:fallo:correo:' . $correo, FALLOS_POR_CORREO)) {
        // El mismo mensaje exista o no la cuenta: el lÃ­mite no revela quÃ© correos estÃ¡n registrados
        $error = 'Demasiados intentos. Espera 15 minutos e intÃ©ntalo de nuevo.';
    } else {
        $consulta = db()->prepare('SELECT * FROM usuarios WHERE correo = ?');
        $consulta->execute([$correo]);
        $usuario = $consulta->fetch();

        $claveValida = $usuario && password_verify($clave, $usuario['clave_hash'] ?? HASH_SIMULADO);

        if (!$claveValida) {
            // Solo los fallos cuentan para el lÃ­mite por correo (asÃ­ nadie bloquea una cuenta ajena desde otro equipo)
            contarIntento('acceso:fallo:correo-ip:' . $correo . ':' . ipCliente(), VENTANA_SEGUNDOS);
            contarIntento('acceso:fallo:correo:' . $correo, VENTANA_SEGUNDOS);
            $error = 'Correo o contraseÃ±a incorrectos.';
        } elseif (!$usuario['activo']) {
            $error = 'Tu cuenta estÃ¡ pendiente de aprobaciÃ³n por un administrador.';
        } else {
            if (password_needs_rehash($usuario['clave_hash'], algoritmoClave())) {
                db()->prepare('UPDATE usuarios SET clave_hash = ? WHERE id = ?')
                    ->execute([hashClave($clave), $usuario['id']]);
            }
            // ContraseÃ±a correcta: falta el tercer paso, el cÃ³digo de 10 dÃ­gitos enviado por correo.
            // Modo desarrollo (archivo): saltar verificaciÃ³n de cÃ³digo y entrar directamente
            if (MAIL_MODO === 'archivo') {
                completarAcceso($usuario);
                redirigir(rutaInicio());
            } elseif (crearYEnviarCodigo($usuario)) {
                session_regenerate_id(true);
                $_SESSION['acceso_pendiente'] = ['id' => (int) $usuario['id'], 'enviado' => time(), 'creado' => time()];
                redirigir('/acceso/verificar.php');
            }
            $error = 'No se pudo enviar el cÃ³digo de verificaciÃ³n. Avisa al administrador.';
        }
    }

    $notificacion = ['tipo' => 'error', 'texto' => $error];
}

$tituloPagina = 'Iniciar sesiÃ³n';
require __DIR__ . '/../app/vistas/plantilla/acceso_encabezado.php';
?>

<div class="acceso__encabezado">
  <h1 class="acceso__titulo">Bienvenido de nuevo</h1>
  <p class="acceso__subtitulo">ContinÃºa cuidando a tus pacientes.</p>
</div>

<?php if (GOOGLE_CLIENT_ID !== ''): ?>
  <a class="acceso__boton acceso__boton--google" href="<?= URL_BASE ?>/acceso/google.php">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.9-3c-1 .7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.4 14.4a7.2 7.2 0 0 1 0-4.7V6.6H1.4a12 12 0 0 0 0 10.9z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.3.6 4.5 1.8l3.4-3.4A12 12 0 0 0 1.4 6.6l4 3.1C6.3 6.9 8.9 4.8 12 4.8z"/></svg>
    Continuar con Google
  </a>
  <div class="acceso__separador"><span>o</span></div>
<?php endif; ?>

<form method="post" class="acceso__formulario" data-acceso-pasos novalidate>
  <?= campoCsrf() ?>
  <label class="sr-only" for="correo">Correo de trabajo</label>
  <input class="acceso__campo" type="email" id="correo" name="correo" value="<?= e($correo) ?>"
         placeholder="Ingresa tu correo de trabajo" autocomplete="username" required>

  <div class="acceso__desplegable<?= $correo !== '' ? ' abierto' : '' ?>" data-acceso-clave>
    <div>
      <label class="sr-only" for="clave">ContraseÃ±a</label>
      <input class="acceso__campo" type="password" id="clave" name="clave"
             placeholder="ContraseÃ±a" autocomplete="current-password">
      <a class="acceso__olvide" href="<?= URL_BASE ?>/acceso/recuperar.php">Â¿Olvidaste tu contraseÃ±a?</a>
    </div>
  </div>

<?php if (RECAPTCHA_SITE_KEY !== '' && $correo !== ''): ?>
  <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response">
  <script>
    (function() {
      var siteKey = '<?= e(RECAPTCHA_SITE_KEY) ?>';
      function getToken() {
        if (typeof grecaptcha === 'undefined') return;
        grecaptcha.ready(function() {
          grecaptcha.execute(siteKey, {action: 'login'}).then(function(token) {
            var el = document.getElementById('g-recaptcha-response');
            if (el) el.value = token;
          });
        });
      }
      // Obtener token al cargar la pagina
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', getToken);
      } else {
        getToken();
      }
      // Y tambien al enviar el formulario (por si el token expiro)
      var form = document.querySelector('form.acceso__formulario');
      if (form) {
        form.addEventListener('submit', function(e) {
          var token = document.getElementById('g-recaptcha-response').value;
          if (!token && typeof grecaptcha !== 'undefined') {
            e.preventDefault();
            grecaptcha.ready(function() {
              grecaptcha.execute(siteKey, {action: 'login'}).then(function(t) {
                document.getElementById('g-recaptcha-response').value = t;
                form.submit();
              });
            });
          }
        });
      }
    })();
  </script>
<?php endif; ?>

  <button type="submit" class="acceso__boton acceso__boton--claro" data-texto-final="Iniciar sesiÃ³n">
    <?= $correo !== '' ? 'Iniciar sesiÃ³n' : 'Continuar con correo' ?>
  </button>
</form>

