{
    "require": {
        "php": "^8.2",
        "anthropic-ai/sdk": "^1.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no"
    }
}
